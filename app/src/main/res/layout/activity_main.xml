<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clean Transcriber"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Adds a mic button to any text box. Your normal keyboard stays as it is." />

        <TextView
            android:id="@+id/micStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Allow microphone" />

        <TextView
            android:id="@+id/svcStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Turn on in Accessibility settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="If it says restricted or is greyed out: open App info below, tap the three dots (top right), choose Allow restricted settings, then try step 2 again." />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open App info" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Options"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbFill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove filler words (um, ah, er)" />

        <CheckBox
            android:id="@+id/cbPunc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add punctuation and capital letters" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/langUk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English (UK)" />

            <RadioButton
                android:id="@+id/langUs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="English (US)" />
        </RadioGroup>

        <EditText
            android:id="@+id/testField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top"
            android:hint="Test it here. Tap this box, then tap the mic button."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="5" />
    </LinearLayout>
</ScrollView>
